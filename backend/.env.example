PORT=5000
NODE_ENV=development

# Paste the real Atlas SRV string from Atlas → Connect → Drivers.
# It must NOT contain the words <username>, <password>, or <cluster>.
# Example shape only:
# MONGODB_URI=mongodb+srv://myUser:myPass@cluster0.abc12.mongodb.net/shelfforge?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=shelfforge_dev_secret_change_me
CLIENT_URL=http://localhost:3000
